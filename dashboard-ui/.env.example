# The Livestock Registry database — the same one the Staff Portal's API writes to.
# Every panel is read from here; the dashboard only ever issues SELECTs.
#
# These values reach the compose stack's Postgres from the host (POSTGRES_PORT and
# the REGISTRY_DB* credentials in ../local/.env). Inside compose the dashboard-ui
# service is wired to the `postgres` service on 5432 instead.
DB_HOST=localhost
DB_PORT=55432
DB_USER=livestock_user
DB_PASSWORD=livestock_pass
DB_NAME=livestock

# Where the header's Back button returns to, and the only origin a ?returnUrl=
# is accepted for. Read at build time, so it must be set before `next build`.
NEXT_PUBLIC_PORTAL_URL=http://portal.localtest.me:3000

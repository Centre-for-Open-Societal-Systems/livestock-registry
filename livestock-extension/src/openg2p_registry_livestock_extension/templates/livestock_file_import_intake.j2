{#-
  Livestock file import. One flat row of a CSV or Excel file (every value a string) becomes the sections
  of one livestock intake. The import worker hands the row over as the business payload, so the columns
  are the register's own field names (docs/file-import.md lists them with their codes).
  Animal rows and the health, vaccination, vital and breeding events are not imported: add them in the
  staff portal or by change request.
  A value the register cannot take fails this row only, with the column named in the error.
-#}
{% macro fail(message) %}{{ {}[message].invalid }}{% endmacro %}
{% set row = expanded if expanded is defined else {} %}
{% set cell = {} %}
{% for key, raw in row.items() %}{% set _ = cell.update({(key | string | trim | lower): ((raw if raw is not none else '') | string | trim)}) %}{% endfor %}

{% set farmer_id = cell.get('farmer_id', '') | upper %}
{% if not (farmer_id.startswith('FR-') and farmer_id[3:].isdigit() and farmer_id | length == 15) %}{{ fail('column farmer_id must be FR- followed by 12 digits, got ' ~ farmer_id) }}{% endif %}
{% set fayda_id = cell.get('fayda_id', '') | replace(' ', '') %}
{% if not (fayda_id.isdigit() and fayda_id | length in [12, 16]) %}{{ fail('column fayda_id must be a 16-digit FAN or a 12-digit FIN, got ' ~ fayda_id) }}{% endif %}

{% set text_columns = ['surveyor_name', 'surveyor_mobile_number', 'supervisor_name', 'supervisor_mobile_number'] %}
{% set number_columns = ['latitude', 'longitude'] %}

{% set personnel = {} %}
{% for key in text_columns %}{% if cell.get(key) %}{% set _ = personnel.update({key: cell[key]}) %}{% endif %}{% endfor %}

{% set number = {} %}
{% for key in number_columns %}{% set value = cell.get(key, '') %}{% if value %}
  {% if not value.replace('-', '', 1).replace('.', '', 1).isdigit() %}{{ fail('column ' ~ key ~ ' must be a number, got ' ~ value) }}{% endif %}
  {% set _ = number.update({key: value | float}) %}
{% endif %}{% endfor %}
{% if 'latitude' in number and (number['latitude'] < -90 or number['latitude'] > 90) %}{{ fail('column latitude must be between -90 and 90, got ' ~ cell.get('latitude')) }}{% endif %}
{% if 'longitude' in number and (number['longitude'] < -180 or number['longitude'] > 180) %}{{ fail('column longitude must be between -180 and 180, got ' ~ cell.get('longitude')) }}{% endif %}
{% if ('latitude' in number) != ('longitude' in number) %}{{ fail('columns latitude and longitude must be given together') }}{% endif %}

{#- The administrative units are Master Data geo unit ids (P-codes: ET04, ET0404, ET040404, ET040404888003),
    as the staff portal's geo-hierarchy widget writes them; geo_code_hierarchy_json carries the chain and
    the registry fills the names from Master Data on save. A level needs the level above it. -#}
{% set geo = {} %}
{% set hierarchy = [] %}
{% for level_id, level in [('l1', 'region'), ('l2', 'zone'), ('l3', 'woreda'), ('l4', 'kebele')] %}{% set code = cell.get(level, '') | upper %}{% if code %}
  {% if hierarchy | length != loop.index0 %}{{ fail('column ' ~ level ~ ' needs the level above it, got ' ~ code) }}{% endif %}
  {% set _ = geo.update({level ~ '_id': code}) %}
  {% set _ = hierarchy.append({'level_id': level_id, 'level': level, 'level_mnemonic': level, 'level_value_id': code}) %}
{% endif %}{% endfor %}
{% if hierarchy %}
  {% set _ = geo.update({'geo_lowest_level_value_id': hierarchy[-1]['level_value_id'], 'geo_code_hierarchy_json': {'hierarchy': hierarchy, 'lowest_level_value_id': hierarchy[-1]['level_value_id']}}) %}
{% endif %}
{% set _ = geo.update(number) %}

{% set lookup = {'record_name': farmer_id, 'farmer_id': farmer_id, 'fayda_fin': fayda_id if fayda_id | length == 12 else none, 'fayda_fan_id': fayda_id if fayda_id | length == 16 else none, 'status': 'ACTIVE', 'state': 'DRAFT'} %}
{% set sections = {'livestock_farmer_lookup': [lookup]} %}
{% if personnel %}{% set _ = sections.update({'ls_survey_personnel': [personnel]}) %}{% endif %}
{% if geo %}{% set _ = sections.update({'ls_livestock_location': [geo]}) %}{% endif %}

{{ sections | tojson }}
